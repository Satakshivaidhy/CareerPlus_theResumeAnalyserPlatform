PORT=4500
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local URI
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=career_assistant

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (for OTPs)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSCODE=your_app_specific_password
